<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab = light pill with dark text; focused = accent ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape>
            <solid android:color="#F2F5FA" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#33FFFFFF" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#F2F5FA" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
