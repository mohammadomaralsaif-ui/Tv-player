<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="@color/accent2" android:endColor="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface2" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/accent_dim" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
