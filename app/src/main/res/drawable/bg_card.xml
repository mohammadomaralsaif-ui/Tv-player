<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#223D8BFF" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#223D8BFF" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
