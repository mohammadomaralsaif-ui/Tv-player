<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="18dp"
        android:paddingEnd="28dp">

        <!-- Top bar: logo + server name, (TV) section tabs, search / refresh / settings, clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/tabsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button android:id="@+id/tabHome" style="@style/NavTab" android:text="الرئيسية" />
                    <Button android:id="@+id/tabLive" style="@style/NavTab" android:text="@string/tab_live" />
                    <Button android:id="@+id/tabMovies" style="@style/NavTab" android:text="@string/tab_movies" />
                    <Button android:id="@+id/tabSeries" style="@style/NavTab" android:text="@string/tab_series" />
                </LinearLayout>
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btnSearch"
                style="@style/IconButton"
                android:contentDescription="بحث"
                android:src="@drawable/ic_nav_search" />

            <ImageButton
                android:id="@+id/btnRefresh"
                style="@style/IconButton"
                android:contentDescription="تحديث من السيرفر"
                android:src="@drawable/ic_nav_refresh" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/IconButton"
                android:contentDescription="الإعدادات"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFeatureSettings="tnum"
                android:textColor="#C5CEDB"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categories"
                    android:layout_width="230dp"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

                <FrameLayout
                    android:id="@+id/contentFrame"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/items"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp" />

                    <TextView
                        android:id="@+id/message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_focus"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="16dp"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- TV live: program info for the focused channel -->
                <include
                    android:id="@+id/livePanel"
                    layout="@layout/panel_live_info"
                    android:layout_width="340dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="18dp"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Phone: bottom navigation within thumb reach -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />
</FrameLayout>
